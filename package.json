{
  "name": "osc_api",
  "version": "1.0.0",
  "description": "osc api",
  "main": "server.js",
  "scripts": {
    "server": "nodemon --exec babel-node src/server.js --ignore 'client/'",
    "client": "yarn --cwd client/ run dev",
    "dev": "concurrently \"yarn run server\" \"yarn run client\"",
    "start": "node server.js"
  },
  "author": "Nikitoring",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@babel/cli": "^7.12.1",
    "@babel/core": "^7.12.3",
    "@babel/node": "^7.12.6",
    "apollo-server-express": "^2.0.0",
    "body-parser": "^1.19.0",
    "concurrently": "^5.3.0",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "graphql": "^15.4.0",
    "graphql-tools": "^7.0.1",
    "mongoose": "^5.10.10",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.12.1",
    "nodemon": "^2.0.6"
  },
  "keywords": []
}
